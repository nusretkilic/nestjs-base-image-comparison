# Alpine runtime: Node.js 24.
# Before experiment measurements, select the exact Node.js and Alpine
# versions and pin NODE_IMAGE by digest.
ARG NODE_IMAGE=node:24-alpine

# Stage 1: compile the application in an Alpine environment.
FROM ${NODE_IMAGE} AS build
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY nest-cli.json tsconfig.json tsconfig.build.json ./
COPY src ./src
RUN npm run build \
    && test -f dist/main.js \
    && find dist -type f \( -name '*.d.ts' -o -name '*.map' \) -delete

# Stage 2: install production dependencies for Alpine's musl environment.
FROM ${NODE_IMAGE} AS production-dependencies
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund

# Stage 3: run the application on the Alpine image.
FROM ${NODE_IMAGE} AS runtime
ENV NODE_ENV=production PORT=3000
WORKDIR /app

COPY --from=production-dependencies --chown=65532:65532 /app/node_modules ./node_modules
COPY --from=build --chown=65532:65532 /app/dist ./dist
COPY --chown=65532:65532 package.json ./

USER 65532:65532
EXPOSE 3000
ENTRYPOINT ["/usr/local/bin/node"]
CMD ["dist/main.js"]
